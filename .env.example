# 心茶記 (Mind Tea Journal) · 本地環境變數設定檔範例
# 請複製本檔案為 .env 並填入您的專屬資訊（.env 已被 .gitignore 忽略，絕不提交至 GitHub）

# 1. Telegram Bot Token（向 Telegram 官方 @BotFather 申請，1分鐘取得）
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. 您的 Telegram Chat ID（向 @userinfobot 或由測試腳本自動取得）
TELEGRAM_CHAT_ID=your_chat_id_here

# 3. Google Gemini API Key（讓 Telegram 機器人擁有即時思考推理大腦，免費於 Google AI Studio 取得）
GEMINI_API_KEY=your_gemini_api_key_here
